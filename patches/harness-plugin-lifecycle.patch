diff --git a/packages/client/ui-settings-plugin-inventory/src/client/PluginConfigurationSection.tsx b/packages/client/ui-settings-plugin-inventory/src/client/PluginConfigurationSection.tsx
new file mode 100644
index 00000000..f854092b
--- /dev/null
+++ b/packages/client/ui-settings-plugin-inventory/src/client/PluginConfigurationSection.tsx
@@ -0,0 +1,407 @@
+import { useEffect, useId, useMemo, useState, type ReactNode } from 'react'
+import type { SettingsNamespaceView, SettingsPathOpView } from '@deepseek-ai/dsh-api-remotes/client'
+import type { SchemaNode, SettingsSchemaService } from '@deepseek-ai/dsh-client-ui-settings/client'
+import { Button } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { PluginInventoryLocaleKey } from './locales.ts'
+import css from './PluginInventorySettingsTab.module.css'
+
+/** A redacted, Web-form-exposed settings namespace collection. */
+export interface PluginConfigurationSnapshot {
+  /** Whether the settings provider accepts writes. */
+  readonly writable: boolean
+  /** Namespaces whose owners explicitly opted into the generic Web form. */
+  readonly namespaces: readonly SettingsNamespaceView[]
+}
+
+/** The author-shaped value one settings path operation carries. */
+type SettingsOpValue = Extract<SettingsPathOpView, { readonly op: 'set' }>['value']
+
+/** Settings-owned schema operations the generic form renders from. */
+export type PluginConfigurationSchema = Pick<
+  SettingsSchemaService,
+  'rehydrate' | 'getPath' | 'hasPath' | 'setPath' | 'deletePath'
+>
+
+/** Host operations the plugin configuration section needs. */
+export interface PluginConfigurationInjected {
+  /** Serialized-schema helpers bound to the settings-owned schema service. */
+  schema: PluginConfigurationSchema
+  /** Read the current Web-form namespace collection. */
+  listConfiguration: () => Promise<PluginConfigurationSnapshot>
+  /** Apply path-addressed changes to one namespace at the revision the editor opened. */
+  mutateConfiguration: (
+    ns: string,
+    ops: readonly SettingsPathOpView[],
+    expectedRevision: number,
+  ) => Promise<SettingsNamespaceView>
+}
+
+interface PluginConfigurationSectionProps extends PluginConfigurationInjected {
+  /** Localized copy supplied by the containing Settings contribution. */
+  t: (key: PluginInventoryLocaleKey) => string
+}
+
+type ConfigurationState =
+  | { readonly status: 'loading' }
+  | { readonly status: 'error' }
+  | { readonly status: 'ready'; readonly snapshot: PluginConfigurationSnapshot }
+
+type ConfigurationSaveFailure = 'conflict' | 'rejected'
+
+/** A JSON-backed editor for structural values that contain no write-only fields. */
+function JsonField({
+  label,
+  value,
+  disabled,
+  onChange,
+  t,
+}: {
+  readonly label: string
+  readonly value: unknown
+  readonly disabled: boolean
+  readonly onChange: (value: unknown) => void
+  readonly t: PluginConfigurationSectionProps['t']
+}): ReactNode {
+  const [draft, setDraft] = useState(() => JSON.stringify(value ?? {}, null, 2))
+  const [invalid, setInvalid] = useState(false)
+
+  useEffect(() => {
+    setDraft(JSON.stringify(value ?? {}, null, 2))
+    setInvalid(false)
+  }, [value])
+
+  return (
+    <label className={css.configField}>
+      <span>{label}</span>
+      <textarea
+        className={css.configTextarea}
+        value={draft}
+        aria-label={label}
+        disabled={disabled}
+        spellCheck={false}
+        onChange={(event) => { setDraft(event.currentTarget.value); setInvalid(false) }}
+        onBlur={() => {
+          try {
+            onChange(JSON.parse(draft))
+          } catch {
+            setInvalid(true)
+          }
+        }}
+      />
+      {invalid ? <span className={css.configFieldError}>{t('invalidJson')}</span> : null}
+    </label>
+  )
+}
+
+/** Render and persist one owner-approved plugin settings namespace. */
+function PluginConfigurationForm({
+  initial,
+  writable,
+  schema,
+  mutateConfiguration,
+  onRefresh,
+  t,
+}: {
+  readonly initial: SettingsNamespaceView
+  readonly writable: boolean
+  readonly schema: PluginConfigurationInjected['schema']
+  readonly mutateConfiguration: PluginConfigurationInjected['mutateConfiguration']
+  /** Re-read all approved configuration after an optimistic-concurrency refusal. */
+  readonly onRefresh: () => void
+  readonly t: PluginConfigurationSectionProps['t']
+}): ReactNode {
+  const [namespace, setNamespace] = useState(initial)
+  const [draft, setDraft] = useState<Record<string, unknown>>(() => userDraft(initial))
+  const [changes, setChanges] = useState<ReadonlyMap<string, SettingsPathOpView>>(() => new Map())
+  const [busy, setBusy] = useState(false)
+  const [failure, setFailure] = useState<ConfigurationSaveFailure | undefined>(undefined)
+  const root = useMemo(() => schema.rehydrate(namespace.schema), [schema, namespace.schema])
+  const disabled = !writable || busy
+
+  useEffect(() => {
+    setNamespace(initial)
+    setDraft(userDraft(initial))
+    setChanges(new Map())
+    setFailure(undefined)
+  }, [initial])
+
+  const valueAt = (path: readonly string[]): unknown => schema.hasPath(draft, path)
+    ? schema.getPath(draft, path)
+    : schema.getPath(namespace.value, path)
+  const setValue = (path: readonly string[], value: unknown): void => {
+    setDraft(current => schema.setPath(current, path, value))
+    setChanges(current => new Map(current).set(pathKey(path), {
+      op: 'set',
+      path: [...path],
+      value: value as SettingsOpValue,
+    }))
+  }
+  const resetValue = (path: readonly string[]): void => {
+    setDraft(current => schema.deletePath(current, path))
+    setChanges(current => new Map(current).set(pathKey(path), { op: 'unset', path: [...path] }))
+  }
+  const save = async (): Promise<void> => {
+    if (changes.size === 0 || busy) return
+    setBusy(true)
+    setFailure(undefined)
+    try {
+      const next = await mutateConfiguration(namespace.ns, [...changes.values()], namespace.revision)
+      setNamespace(next)
+      setDraft(userDraft(next))
+      setChanges(new Map())
+    } catch (error: unknown) {
+      setFailure(isSettingsConflict(error) ? 'conflict' : 'rejected')
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const renderField = (node: SchemaNode, path: readonly string[]): ReactNode => {
+    if (node.meta.hidden === true) return null
+    const label = path.join(' / ')
+    if (node.meta.role === 'secret') {
+      const slot = namespace.secrets.find(secret => samePath(secret.path, path))
+      return (
+        <label className={css.configField} key={pathKey(path)}>
+          <span>{label}</span>
+          <input
+            className={css.configInput}
+            type="password"
+            autoComplete="off"
+            value={typeof schema.getPath(draft, path) === 'string' ? schema.getPath(draft, path) as string : ''}
+            aria-label={label}
+            placeholder={slot?.set === true ? t('secretConfigured') : t('secretPlaceholder')}
+            disabled={disabled}
+            onChange={(event) => {
+              const value = event.currentTarget.value
+              if (value.length > 0) setValue(path, value)
+            }}
+          />
+          {slot?.set === true ? (
+            <Button type="button" variant="toolbar" size="sm" disabled={disabled} onClick={() => { resetValue(path) }}>
+              {t('clearSecret')}
+            </Button>
+          ) : null}
+        </label>
+      )
+    }
+    if (node.type === 'object') {
+      const children = Object.entries(node.dict ?? {})
+        .map(([key, child]) => renderField(child, [...path, key]))
+        .filter((child): child is ReactNode => child !== null)
+      if (children.length === 0) return null
+      if (path.length === 0) return <div className={css.configFields} key="root">{children}</div>
+      return (
+        <fieldset className={css.configGroup} key={pathKey(path)}>
+          <legend>{label}</legend>
+          <div className={css.configFields}>{children}</div>
+        </fieldset>
+      )
+    }
+    if (node.type === 'transform' || node.type === 'lazy') {
+      return node.inner === undefined
+        ? unsupportedField(label, path, t)
+        : renderField(node.inner, path)
+    }
+    const value = valueAt(path)
+    if (node.type === 'boolean') {
+      return (
+        <label className={css.configCheckbox} key={pathKey(path)}>
+          <input
+            type="checkbox"
+            checked={value === true}
+            aria-label={label}
+            disabled={disabled}
+            onChange={(event) => { setValue(path, event.currentTarget.checked) }}
+          />
+          <span>{label}</span>
+        </label>
+      )
+    }
+    if (node.type === 'number') {
+      return (
+        <label className={css.configField} key={pathKey(path)}>
+          <span>{label}</span>
+          <input
+            className={css.configInput}
+            type="number"
+            value={typeof value === 'number' ? String(value) : ''}
+            aria-label={label}
+            disabled={disabled}
+            onChange={(event) => {
+              const text = event.currentTarget.value
+              if (text === '') resetValue(path)
+              else setValue(path, Number(text))
+            }}
+          />
+        </label>
+      )
+    }
+    if (node.type === 'string') {
+      return (
+        <label className={css.configField} key={pathKey(path)}>
+          <span>{label}</span>
+          <input
+            className={css.configInput}
+            type="text"
+            value={typeof value === 'string' ? value : ''}
+            aria-label={label}
+            disabled={disabled}
+            onChange={(event) => { setValue(path, event.currentTarget.value) }}
+          />
+        </label>
+      )
+    }
+    const choices = constantChoices(node)
+    if (choices !== undefined) {
+      const selected = choices.findIndex(choice => Object.is(choice, value))
+      return (
+        <label className={css.configField} key={pathKey(path)}>
+          <span>{label}</span>
+          <select
+            className={css.configInput}
+            value={selected < 0 ? '' : String(selected)}
+            aria-label={label}
+            disabled={disabled}
+            onChange={(event) => { setValue(path, choices[Number(event.currentTarget.value)]!) }}
+          >
+            {selected < 0 ? <option value="" disabled>{t('selectValue')}</option> : null}
+            {choices.map((choice, index) => <option key={String(choice)} value={String(index)}>{String(choice)}</option>)}
+          </select>
+        </label>
+      )
+    }
+    if ((node.type === 'array' || node.type === 'tuple' || node.type === 'dict') && !hasSecretBelow(namespace, path)) {
+      return <JsonField key={pathKey(path)} label={label} value={value} disabled={disabled} onChange={(next) => { setValue(path, next) }} t={t} />
+    }
+    return unsupportedField(label, path, t)
+  }
+
+  return (
+    <section className={css.configForm} aria-label={`${t('pluginConfiguration')} ${namespace.ns}`}>
+      <div className={css.configHeading}>
+        <code>{namespace.ns}</code>
+        {namespace.applies === 'restart' ? <span>{t('restartRequired')}</span> : null}
+      </div>
+      {renderField(root, [])}
+      {failure === undefined ? null : (
+        <div className={css.configFailure} role="alert">
+          <p>{t(failure === 'conflict' ? 'configurationConflict' : 'configurationSaveFailed')}</p>
+          {failure === 'conflict' ? (
+            <Button type="button" variant="outline" size="sm" disabled={busy} onClick={onRefresh}>
+              {t('refreshConfiguration')}
+            </Button>
+          ) : null}
+        </div>
+      )}
+      <div className={css.configActions}>
+        <Button type="button" variant="outline" disabled={disabled || changes.size === 0} onClick={() => { void save() }}>
+          {busy ? t('savingConfiguration') : t('saveConfiguration')}
+        </Button>
+      </div>
+    </section>
+  )
+}
+
+/** Render the owner-approved plugin configuration section. */
+export function PluginConfigurationSection({
+  schema,
+  listConfiguration,
+  mutateConfiguration,
+  t,
+}: PluginConfigurationSectionProps): ReactNode {
+  const headingId = useId()
+  const [request, setRequest] = useState(0)
+  const [state, setState] = useState<ConfigurationState>({ status: 'loading' })
+
+  const refresh = (): void => {
+    setState({ status: 'loading' })
+    setRequest(value => value + 1)
+  }
+
+  useEffect(() => {
+    let current = true
+    void Promise.resolve().then(() => listConfiguration()).then(
+      (snapshot) => { if (current) setState({ status: 'ready', snapshot }) },
+      () => { if (current) setState({ status: 'error' }) },
+    )
+    return () => { current = false }
+  }, [listConfiguration, request])
+
+  return (
+    <section className={css.configuration} aria-labelledby={headingId} aria-busy={state.status === 'loading'}>
+      <div className={css.catalogHeading}>
+        <h3 id={headingId}>{t('pluginConfiguration')}</h3>
+      </div>
+      {state.status === 'loading' ? <p className={css.status}>{t('loadingConfiguration')}</p> : null}
+      {state.status === 'error' ? (
+        <div className={css.failure}>
+          <p role="alert">{t('configurationError')}</p>
+          <button type="button" onClick={refresh}>{t('retry')}</button>
+        </div>
+      ) : null}
+      {state.status === 'ready' && state.snapshot.namespaces.length === 0
+        ? <p className={css.status}>{t('noPluginConfiguration')}</p>
+        : null}
+      {state.status === 'ready' ? state.snapshot.namespaces.map(namespace => (
+        <PluginConfigurationForm
+          key={namespace.ns}
+          initial={namespace}
+          writable={state.snapshot.writable}
+          schema={schema}
+          mutateConfiguration={mutateConfiguration}
+          onRefresh={refresh}
+          t={t}
+        />
+      )) : null}
+    </section>
+  )
+}
+
+/** Return a clone of the redacted raw user layer for form-local edits. */
+function userDraft(namespace: SettingsNamespaceView): Record<string, unknown> {
+  return typeof namespace.user === 'object' && namespace.user !== null && !Array.isArray(namespace.user)
+    ? structuredClone(namespace.user) as Record<string, unknown>
+    : {}
+}
+
+/** Stable map key for a settings path. */
+function pathKey(path: readonly string[]): string {
+  return JSON.stringify(path)
+}
+
+/** Compare two settings paths without assigning special semantics to key text. */
+function samePath(left: readonly string[], right: readonly string[]): boolean {
+  return left.length === right.length && left.every((part, index) => part === right[index])
+}
+
+/** Whether a failed Remote write was refused because the edited revision is stale. */
+function isSettingsConflict(error: unknown): boolean {
+  return typeof error === 'object'
+    && error !== null
+    && 'code' in error
+    && (error as { readonly code?: unknown }).code === 'settings/conflict'
+}
+
+/** Whether a structural field encloses a write-only descendant that JSON editing cannot preserve. */
+function hasSecretBelow(namespace: SettingsNamespaceView, path: readonly string[]): boolean {
+  return namespace.secrets.some(secret => path.every((part, index) => part === secret.path[index]))
+}
+
+/** Extract a scalar union's choices, leaving all other unions to their owner configuration file. */
+function constantChoices(node: SchemaNode): readonly (string | number | boolean)[] | undefined {
+  if (node.type !== 'union' || node.list === undefined) return undefined
+  const choices = node.list.map(entry => entry.type === 'const' ? entry.value : undefined)
+  return choices.every(value => typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean')
+    ? choices as Array<string | number | boolean>
+    : undefined
+}
+
+/** Explain an intentionally unsupported field instead of exposing a lossy editor. */
+function unsupportedField(
+  label: string,
+  path: readonly string[],
+  t: PluginConfigurationSectionProps['t'],
+): ReactNode {
+  return <p className={css.configUnsupported} key={pathKey(path)}>{`${label}: ${t('unsupportedConfiguration')}`}</p>
+}
