{
  "name": "dsh-desktop",
  "version": "0.1.6",
  "description": "DeepSeek Harness 的 macOS 桌面版：承载网页界面、管理后端与社区插件。",
  "main": "main.js",
  "homepage": "https://github.com/deepseek-ai/deepseek-harness",
  "scripts": {
    "start": "electron .",
    "smoke": "DSH_DESKTOP_SMOKE=1 DSH_DESKTOP_WEB_PORT=3180 DSH_DESKTOP_DSH_HOME=/private/tmp/dsh-desktop-smoke-profile electron .",
    "icon": "node scripts/gen-icon.js && bash scripts/build-icns.sh",
    "test": "node --test test/*.test.js",
    "verify": "npm test && node --check main.js && node --check lib/*.js",
    "dist": "electron-builder --mac dmg"
  },
  "author": "dsh-desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Harness",
    "artifactName": "DeepSeek-Harness-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "lib/*.js",
      "runtime/**/*",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "harness.tar",
      "harness.bundle.json"
    ],
    "asarUnpack": [
      "runtime/**/*",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "harness.tar",
      "harness.bundle.json",
      "lib/promotion-helper.js"
    ],
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "YUANIMAL",
        "repo": "deepseek-harness-desktop"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "title": "DeepSeek Harness ${version}",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 420,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
